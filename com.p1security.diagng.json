{
    "app-id": "com.p1security.diagng",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "command": "diagng",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm22"
    ],
    "finish-args": [
        /**
         * We need this to run the GTK-4 app
         */
        "--share=ipc",
        "--share=network",
        "--socket=fallback-x11",
        "--socket=wayland",

        /**
         * We need the --device=all permission in order to
         * able to scan devices with pyudev.glib
         */
        "--device=all",

        /**
         * We need this permission so that we can check
         * for the presence of the GSMTAP v3 decoding
         * plug-in on the system, and install it if
         * not present
         */
        "--filesystem=~/.local/lib/wireshark/plugins:create",

        /**
         * We need to be able to use the "flatpak-spawn"
         * command in order to connect to raw USB devices
         * and SPI devices in a privileged fashion on
         * the system through the "diagmond" system DBus
         * daemon, which will authentify privileged
         * user-initiated actions using a PolKit request.
         * See:
         * - https://github.com/flathub/flathub/pull/10329#discussion_r4065045730
         * - https://github.com/flathub-infra/flatpak-builder-lint/pull/1175
         * - https://github.com/P1sec/DiagNG#technical-architecture
         * - https://github.com/P1sec/DiagNG/tree/main/diagmond
         */
        "--talk-name=org.freedesktop.Flatpak",
        "--system-talk-name=com.p1security.diagmond",

        /**
         * We need to talk to the ModemManager daemon in
         * order to query device status and check for the
         * risk of interference over the system.
         */
        "--system-talk-name=org.freedesktop.ModemManager1"
    ],
    "build-options": {
        "append-path" : "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm22/bin",
        "prepend-ld-library-path": "/usr/lib/sdk/llvm22/lib",
        "env" : {
            "CARGO_HOME" : "/run/build/diagng/.cargo"
        }
    },
    "modules": [
        {
            "name": "libmm-glib",
            "buildsystem": "meson",
            "builddir": true,
            "config-opts": [
                "--libdir=/app/lib",
                "--buildtype=release",
                "-Dudev=false",
                "-Dmbim=false",
                "-Dqmi=false",
                "-Dudevdir=/app/",
                "-Dbash_completion=false",
                "-Dman=false",
                "-Dsystemd_suspend_resume=false",
                "-Dpowerd_suspend_resume=false",
                "-Dsystemd_journal=false",
                "-Dsystemdsystemunitdir=no",
                "-Dpolkit=no",
                "-Dqrtr=false"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.freedesktop.org/mobile-broadband/ModemManager.git",
                    "tag": "1.24.2",
                    "commit": "f2b9ab1ad78d322f32134a444b5b54c6e8160e19",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        },
        "python3-modules.json",
        {
            "name": "diagmond",
            "buildsystem": "simple",
            "build-commands": [
                "cargo --offline fetch --verbose",
                "cargo --offline build --release --verbose",
                "install -Dm755 ./target/release/diagmond-bin -t /app/bin/",
                "cp -r ./share/dbus-1 /app/share/",
                "cp -r ./share/polkit-1 /app/share/"
            ],
            "sources": [
                {
                    "type": "archive",
                    "url": "https://github.com/P1sec/DiagNG/releases/download/0.1.0/diagmond_tarball_0.1.0_for_flathub_build.tar.gz",
                    "sha256": "ca460992fa40e1e4464ff26a6b083401e14232ee0ffe6d34425094885b63be91",
                    "x-checker-data": {
                        "type": "json",
                        "url": "https://api.github.com/repos/P1sec/DiagNG/releases/latest",
                        "version-query": ".tag_name",
                        "url-query": ".assets[] | select(.name==\"diagmond_tarball_\" + $version + \"_for_flathub_build.tar.gz\") | .browser_download_url"
                    }
                }
            ]
        },
        {
            "name": "diagng",
            "buildsystem": "simple",
            "build-commands": [
                "mkdir -p /app/bin/",
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \".\" --no-build-isolation",
                "install -Dm644 ./src/diagng/ui/assets/share/icons/hicolor/scalable/apps/com.p1security.diagng.svg -t /app/share/icons/hicolor/scalable/apps/",
                "install -Dm644 ./src/diagng/ui/assets/share/metainfo/com.p1security.diagng.metainfo.xml -t /app/share/metainfo/",
                "install -Dm644 ./src/diagng/ui/assets/share/applications/com.p1security.diagng.desktop -t /app/share/applications/",
                "install -Dm644 ./src/diagng/ui/assets/share/dbus-1/interfaces/com.p1security.diagmetad.xml -t /app/share/dbus-1/interfaces/",
                "install -Dm644 ./src/diagng/ui/assets/share/dbus-1/services/com.p1security.diagmetad.service -t /app/share/dbus-1/services/",
                "rm -rf diagmond src struct docs *.g* packaging tests *.md *.lock *.yaml LICENSE"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/P1sec/DiagNG",
                    "tag": "0.1.0",
                    "commit": "c72d17ce3cfca06fe5c0c72cf49157c7ca7fe4a7",
                    "x-checker-data": {
                        "type": "git",
                        "tag-pattern": "^([\\d.]+)$"
                    }
                }
            ]
        }
    ]
}
